@startuml
skinparam linetype ortho

interface ICard {
    - name: String
    - description: String
    - id: String
    - actions: List<IAction>
}

interface IPlayableCard extends ICard {
    - hp: int
    - status: Optional<IStatus>
    - tool: Optional<ToolCard>
}

interface ITrainerCard extends ICard {
}

/' Fossil cards, their IAction will be to discard itself '/
class PlayableItemCard implements IPlayableCard, ITrainerCard {}

class ItemCard implements ITrainerCard {}

class SupporterCard implements ITrainerCard {}

class ToolCard implements ITrainerCard {
    - triggers: List<ITrigger>
}

class StadiumCard implements ITrainerCard {
    - triggers: List<ITrigger>
}

/' Will also need tags to track whether the card is a mega, EX, etc. '/
class PokemonCard implements IPlayableCard {
    - stage: int
    - type: Type
    - ability: Optional<IAbility>
    - retreatCost: int
    - weakness: Optional<Type>
    - weaknessDamage: Optional<INumber>
}

@enduml