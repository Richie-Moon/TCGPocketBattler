@startuml
title IEffect — the only thing permitted to mutate the board

skinparam linetype ortho

interface IEffect <<sealed>> {
    + apply(ResolutionContext): EffectOutcome
}

/'
  Returning an outcome rather than void is what makes IAttempt failable.
  See IAttempt.puml for the short-circuit rule.
'/
enum EffectOutcome {
    /' Did what it said. '/
    APPLIED
    /' Nothing to do, and that is fine — healing a Pokemon at full HP,
       discarding energy from a Pokemon with none. Does NOT abort. '/
    NO_OP
    /' Could not be done — target did not resolve, cost unpayable.
       ABORTS the rest of the attempt. '/
    FAILED
}

interface IDurationEffect <<sealed>> extends IEffect {
    /' Turns; installs an ActiveModifier on the target. See Damage.puml. '/
    - duration: INumber
}

/' --- Coin flips --- '/

/' Flips and records the result in ResolutionScope, where NumberHeads,
   LastCoinTossHeads and AllFlipsHeads then read it. '/
interface IFlipStrategy <<sealed>> extends IEffect {
    + flip(ResolutionContext): FlipResult
}

class FlipN <<record>> implements IFlipStrategy {
    - n: INumber
}

class FlipUntilTails <<record>> implements IFlipStrategy {}

/' --- Cards --- '/

class DrawCard <<record>> implements IEffect {
    - cardCount: INumber
    - side: ISideTarget
}

class ShuffleHandIntoDeck <<record>> implements IEffect {
    - side: ISideTarget
}

class DiscardFromHand <<record>> implements IEffect {
    - side: ISideTarget
    - cardCount: INumber
    - matching: Optional<ICondition<CardInstance>>
}

/' --- Damage --- '/

/' Amount is the BASE damage. Weakness and active modifiers are applied by the
   damage pipeline, not here. See Damage.puml. '/
class DealDamage <<record>> implements IEffect {
    - damageAmount: INumber
    - target: ITarget
}

/' Distributed at random across the opposing board, in 10s. '/
class SpreadDamage <<record>> implements IEffect {
    - damageAmount: INumber
    - targets: IMultiTarget
}

/' Same target struck repeatedly; each hit runs the full pipeline separately,
   which matters for knockouts partway through. '/
class MultiHit <<record>> implements IEffect {
    - target: ITarget
    - damage: INumber
    - timesToHit: INumber
}

class DamageEach <<record>> implements IEffect {
    - damageAmount: INumber
    - targets: IMultiTarget
}

class HealDamage <<record>> implements IEffect {
    - healAmount: INumber
    - target: ITarget
}

/' --- Energy --- '/

class AttachEnergy <<record>> implements IEffect {
    - energyType: Type
    - energyCount: INumber
    - target: ITarget
}

/' Attaches from the Side's Energy Zone rather than from nowhere — the two are
   different game actions and only one of them is limited to once per turn. '/
class AttachFromEnergyZone <<record>> implements IEffect {
    - target: ITarget
}

class DiscardRandomEnergy <<record>> implements IEffect {
    - energyCount: INumber
    - target: ITarget
}

class DiscardTypeEnergy <<record>> implements IEffect {
    - energyType: Type
    - energyCount: INumber
    - target: ITarget
}

class MoveEnergy <<record>> implements IEffect {
    - from: ITarget
    - to: ITarget
    - energyCount: INumber
}

/' --- Buffs / debuffs --- '/

class ReduceDamage <<record>> implements IDurationEffect {
    - reductionAmount: INumber
    - target: ITarget
}

class IncreaseDamage <<record>> implements IDurationEffect {
    - increaseAmount: INumber
    - target: ITarget
}

class PreventDamage <<record>> implements IDurationEffect {
    - target: ITarget
}

/' --- Board --- '/

class SwitchActive <<record>> implements IEffect {
    - side: ISideTarget
    /' Empty = the controller of that side chooses. See IPlayer.puml. '/
    - replacement: Optional<ITarget>
}

class AddStatus <<record>> implements IEffect {
    - target: ITarget
    - statusToAdd: IStatus
}

class RemoveStatus <<record>> implements IEffect {
    - target: ITarget
    - statusToRemove: IStatus
}

class AttachTool <<record>> implements IEffect {
    - target: ITarget
    - tool: ToolCard
}

/' --- Composition --- '/

/' Applies its inner effect only if the condition holds; otherwise NO_OP.
   Distinct from an Attempt short-circuit: this branch is expected to be
   skipped, so it must not abort what follows. '/
class ConditionalEffect <<record>> implements IEffect {
    - condition: ICondition<ResolutionContext>
    - effect: IEffect
}

class RepeatEffect <<record>> implements IEffect {
    - times: INumber
    - effect: IEffect
}

/' Null Object Pattern '/
class NoEffect <<record>> implements IEffect {}

note bottom of NoEffect
  Removed: DealMappedDamage. Its Map<INumber, INumber> keyed on
  expression objects, so lookup by evaluated value could never
  match. Replaced by INumber.Branch, which is composable and also
  serves heal amounts and draw counts. See INumber.puml.
end note

@enduml
